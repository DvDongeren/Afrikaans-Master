rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Een document per gebruiker: users/{uid} = { data: tekst, mt: tijdstip, v: versie }.
    // Alleen de eigenaar mag lezen, schrijven en verwijderen; vorm en grootte worden gecontroleerd.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function validDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['data', 'mt', 'v'])
        && d.keys().hasAll(['data', 'mt', 'v'])
        && d.data is string && d.data.size() < 900000
        && d.mt is number
        && d.v is int && d.v >= 1 && d.v <= 10;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && validDoc();
      allow delete: if isOwner(userId);
    }

    // Meldingen over kaarten: iedereen mag er een insturen (ook zonder account), alleen in de
    // verwachte vorm en met het tijdstip van de server. Alleen beheerders mogen ze lezen en wissen.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function validReport() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'af', 'nl', 'note', 't', 'by'])
        && d.keys().hasAll(['id', 'af', 'nl', 'note', 't'])
        && d.id is int && d.id >= 0 && d.id < 1000000
        && d.af is string && d.af.size() > 0 && d.af.size() <= 200
        && d.nl is string && d.nl.size() <= 200
        && d.note is string && d.note.size() <= 500
        && d.t == request.time
        && (!('by' in d) || (request.auth != null && d.by == request.auth.uid));
    }
    match /reports/{reportId} {
      allow create: if validReport();
      allow read, delete: if isAdmin();
    }

    // Technische fouten uit de app (zonder persoonsgegevens): aanmaken mag, lezen alleen beheerders.
    function validError() {
      let d = request.resource.data;
      return d.keys().hasOnly(['k', 'm', 's', 'v', 'ver', 'b', 't'])
        && d.keys().hasAll(['k', 'm', 't'])
        && d.k in ['error', 'promise']
        && d.m is string && d.m.size() > 0 && d.m.size() <= 300
        && (!('s' in d) || (d.s is string && d.s.size() <= 800))
        && (!('v' in d) || (d.v is string && d.v.size() <= 20))
        && (!('ver' in d) || (d.ver is string && d.ver.size() <= 20))
        && (!('b' in d) || (d.b is string && d.b.size() <= 30))
        && d.t == request.time;
    }
    match /errors/{errorId} {
      allow create: if validError();
      allow read, delete: if isAdmin();
    }

    // Correcties op kaarten door een beheerder: iedereen mag ze lezen (de app past ze toe),
    // alleen beheerders mogen ze schrijven of verwijderen. Het document-ID is het kaartnummer.
    function validFix() {
      let d = request.resource.data;
      return d.keys().hasOnly(['af', 'nl', 'voorbeeld', 'vbnl', 'tips', 't'])
        && d.af is string && d.af.size() > 0 && d.af.size() <= 200
        && d.nl is string && d.nl.size() > 0 && d.nl.size() <= 200
        && (!('voorbeeld' in d) || (d.voorbeeld is string && d.voorbeeld.size() <= 400))
        && (!('vbnl' in d) || (d.vbnl is string && d.vbnl.size() <= 400))
        && (!('tips' in d) || (d.tips is string && d.tips.size() <= 400))
        && d.t == request.time;
    }
    match /fixes/{cardId} {
      allow read: if true;
      allow create, update: if isAdmin() && cardId.matches('^[0-9]{1,7}$') && validFix();
      allow delete: if isAdmin();
    }

    // Anonieme gebruikstellingen per dag (geen persoonsgegevens): alleen tellers in vaste velden.
    match /stats/{day} {
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['v', 'd', 'f', 'x'])
        && request.resource.data.get('v', {}).size() <= 100
        && request.resource.data.get('d', {}).size() <= 100
        && request.resource.data.get('f', {}).size() <= 6000
        && request.resource.data.get('x', {}).size() <= 10;
      allow read, delete: if isAdmin();
    }

    // Beheerders: maak in de Firebase-console een document admins/{jouw-uid} aan.
    // Alleen jijzelf mag controleren of je beheerder bent; niemand kan zichzelf toevoegen.
    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
    }

    // Al het andere is dicht (ook lijsten van alle gebruikers opvragen).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
